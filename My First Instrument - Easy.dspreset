<?xml version="1.0" encoding="UTF-8"?>
<DecentSampler minVersion="1.27.0">
  <!-- EASY: sample mapping. See README.md -->

  <!-- ============================ SAMPLES ============================ -->
  <groups>
    <group loVel="1" hiVel="127" attack="0.0" release="0.48" ampVelTrack="0.2">
      <sample rootNote="47" loNote="0"  hiNote="47"  path="Samples/BasitarPlucks/BasitarPlucks_047_RR1.flac" />
      <sample rootNote="54" loNote="48" hiNote="54"  path="Samples/BasitarPlucks/BasitarPlucks_054_RR1.flac" />
      <sample rootNote="59" loNote="55" hiNote="59"  path="Samples/BasitarPlucks/BasitarPlucks_059_RR1.flac" />
      <sample rootNote="61" loNote="60" hiNote="61"  path="Samples/BasitarPlucks/BasitarPlucks_061_RR1.flac" />
      <sample rootNote="66" loNote="62" hiNote="127" path="Samples/BasitarPlucks/BasitarPlucks_066_RR1.flac" />
    </group>
  </groups>

  <!-- ========================= USER INTERFACE ======================== -->
  <ui width="812" height="230" bgColor="FF14161F">
    <tab name="main">
      <rectangle x="0" y="0" width="812" height="56" fillColor="FF1E2230" />
      <rectangle x="0" y="54" width="812" height="2" fillColor="FF4FD1C5" />
      <label x="20" y="8" width="500" height="26" text="MY FIRST INSTRUMENT"
             textColor="FFFFFFFF" textSize="22" hAlign="left" />
      <label x="20" y="32" width="560" height="18"
             text="EASY  ·  5 zones  ·  1 sample per zone"
             textColor="FF8A93AD" textSize="12" hAlign="left" />
      <label x="600" y="18" width="192" height="20" text="LEVEL 1 / 3"
             textColor="FF4FD1C5" textSize="14" hAlign="right" />

      <rectangle x="16" y="68" width="300" height="142" fillColor="FF1E2230" />
      <label x="28" y="74" width="280" height="18" text="AMP"
             textColor="FF4FD1C5" textSize="13" hAlign="left" />

      <labeled-knob x="26" y="96" width="80" height="106" label="Volume"
                    type="float" minValue="0" maxValue="1" value="0.8"
                    textColor="FFE8ECF5" textSize="13"
                    trackForegroundColor="FF4FD1C5" trackBackgroundColor="FF2E3446">
        <binding type="amp" level="instrument" position="0" parameter="AMP_VOLUME" />
      </labeled-knob>
      <labeled-knob x="116" y="96" width="80" height="106" label="Attack"
                    type="float" minValue="0" maxValue="5" value="0"
                    textColor="FFE8ECF5" textSize="13"
                    trackForegroundColor="FF4FD1C5" trackBackgroundColor="FF2E3446">
        <binding type="amp" level="group" position="0" parameter="ENV_ATTACK" />
      </labeled-knob>
      <labeled-knob x="206" y="96" width="80" height="106" label="Release"
                    type="float" minValue="0" maxValue="10" value="0.48"
                    textColor="FFE8ECF5" textSize="13"
                    trackForegroundColor="FF4FD1C5" trackBackgroundColor="FF2E3446">
        <binding type="amp" level="group" position="0" parameter="ENV_RELEASE" />
      </labeled-knob>
    </tab>
  </ui>
</DecentSampler>
