<?xml version="1.0" encoding="UTF-8"?>
<DecentSampler minVersion="1.27.0">
  <!-- EASY: sample mapping. See README.md -->

  <!-- ============================ SAMPLES ============================ -->
  <groups>
    <group loVel="1" hiVel="127" attack="0.0" release="0.48" ampVelTrack="0.2">
      <sample rootNote="47" loNote="0"  hiNote="47"  path="Samples/BasitarPlucks/BasitarPlucks_047_RR1.flac" />
      <sample rootNote="54" loNote="48" hiNote="54"  path="Samples/BasitarPlucks/BasitarPlucks_054_RR1.flac" />
      <sample rootNote="59" loNote="55" hiNote="59"  path="Samples/BasitarPlucks/BasitarPlucks_059_RR1.flac" />
      <sample rootNote="61" loNote="60" hiNote="61"  path="Samples/BasitarPlucks/BasitarPlucks_061_RR1.flac" />
      <sample rootNote="66" loNote="62" hiNote="127" path="Samples/BasitarPlucks/BasitarPlucks_066_RR1.flac" />
    </group>
  </groups>









  <!-- ========================= USER INTERFACE ======================== -->
  <ui width="812" height="375" bgColor="FFFFFFFF">
    <tab name="main">
      <label x="24" y="12" width="600" height="26" text="My First Instrument - Easy" textColor="FF000000" textSize="18" hAlign="left" />

      <!-- Amp -->
      <label x="24" y="50" width="150" height="18" text="Amp" textColor="FF666666" textSize="12" hAlign="left" />
      <control x="39" y="72" width="20" height="120" style="linear_bar_vertical"
               parameterName="Volume" showLabel="false" type="float" minValue="0" maxValue="1" value="0.8"
               trackForegroundColor="FF333333" trackBackgroundColor="FFDDDDDD">
        <binding type="amp" level="instrument" position="0" parameter="AMP_VOLUME" />
      </control>
      <label x="24" y="196" width="50" height="16" text="Volume" textColor="FF000000" textSize="11" hAlign="centred" />
      <control x="89" y="72" width="20" height="120" style="linear_bar_vertical"
               parameterName="Attack" showLabel="false" type="float" minValue="0" maxValue="5" value="0"
               trackForegroundColor="FF333333" trackBackgroundColor="FFDDDDDD">
        <binding type="amp" level="group" position="0" parameter="ENV_ATTACK" />
      </control>
      <label x="74" y="196" width="50" height="16" text="Attack" textColor="FF000000" textSize="11" hAlign="centred" />
      <control x="139" y="72" width="20" height="120" style="linear_bar_vertical"
               parameterName="Release" showLabel="false" type="float" minValue="0" maxValue="10" value="0.48"
               trackForegroundColor="FF333333" trackBackgroundColor="FFDDDDDD">
        <binding type="amp" level="group" position="0" parameter="ENV_RELEASE" />
      </control>
      <label x="124" y="196" width="50" height="16" text="Release" textColor="FF000000" textSize="11" hAlign="centred" />
    </tab>
  </ui>
</DecentSampler>
