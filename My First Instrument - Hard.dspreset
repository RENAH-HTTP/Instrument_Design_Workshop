<?xml version="1.0" encoding="UTF-8"?>
<DecentSampler minVersion="1.27.0">
  <!-- HARD: 10 zones x 3 round robins + legato + effects + LFO + full UI. See README.md -->

  <!-- ============================ SAMPLES ============================ -->
  <groups polyphony="1" glideTime="0.08" glideMode="legato" returnToHeldNote="true" seqMode="round_robin" seqLength="3" attack="0.02" decay="0.3" sustain="0.8" release="0.8" ampVelTrack="0.5">
    <group seqPosition="1">
      <sample rootNote="52" loNote="0" hiNote="57" path="Samples/DH WARP3/DH WARP3_052_RR1.flac" />
      <sample rootNote="62" loNote="58" hiNote="63" path="Samples/DH WARP3/DH WARP3_062_RR1.flac" />
      <sample rootNote="64" loNote="64" hiNote="65" path="Samples/DH WARP3/DH WARP3_064_RR1.flac" />
      <sample rootNote="67" loNote="66" hiNote="69" path="Samples/DH WARP3/DH WARP3_067_RR1.flac" />
      <sample rootNote="71" loNote="70" hiNote="72" path="Samples/DH WARP3/DH WARP3_071_RR1.flac" />
      <sample rootNote="74" loNote="73" hiNote="75" path="Samples/DH WARP3/DH WARP3_074_RR1.flac" />
      <sample rootNote="76" loNote="76" hiNote="77" path="Samples/DH WARP3/DH WARP3_076_RR1.flac" />
      <sample rootNote="78" loNote="78" hiNote="80" path="Samples/DH WARP3/DH WARP3_078_RR1.flac" />
      <sample rootNote="83" loNote="81" hiNote="89" path="Samples/DH WARP3/DH WARP3_083_RR1.flac" />
      <sample rootNote="96" loNote="90" hiNote="127" path="Samples/DH WARP3/DH WARP3_096_RR1.flac" />
    </group>
    <group seqPosition="2">
      <sample rootNote="52" loNote="0" hiNote="57" path="Samples/DH WARP3/DH WARP3_052_RR2.flac" />
      <sample rootNote="62" loNote="58" hiNote="63" path="Samples/DH WARP3/DH WARP3_062_RR2.flac" />
      <sample rootNote="64" loNote="64" hiNote="65" path="Samples/DH WARP3/DH WARP3_064_RR2.flac" />
      <sample rootNote="67" loNote="66" hiNote="69" path="Samples/DH WARP3/DH WARP3_067_RR2.flac" />
      <sample rootNote="71" loNote="70" hiNote="72" path="Samples/DH WARP3/DH WARP3_071_RR2.flac" />
      <sample rootNote="74" loNote="73" hiNote="75" path="Samples/DH WARP3/DH WARP3_074_RR2.flac" />
      <sample rootNote="76" loNote="76" hiNote="77" path="Samples/DH WARP3/DH WARP3_076_RR2.flac" />
      <sample rootNote="78" loNote="78" hiNote="80" path="Samples/DH WARP3/DH WARP3_078_RR2.flac" />
      <sample rootNote="83" loNote="81" hiNote="89" path="Samples/DH WARP3/DH WARP3_083_RR2.flac" />
      <sample rootNote="96" loNote="90" hiNote="127" path="Samples/DH WARP3/DH WARP3_096_RR2.flac" />
    </group>
    <group seqPosition="3">
      <sample rootNote="52" loNote="0" hiNote="57" path="Samples/DH WARP3/DH WARP3_052_RR3.flac" />
      <sample rootNote="62" loNote="58" hiNote="63" path="Samples/DH WARP3/DH WARP3_062_RR3.flac" />
      <sample rootNote="64" loNote="64" hiNote="65" path="Samples/DH WARP3/DH WARP3_064_RR3.flac" />
      <sample rootNote="67" loNote="66" hiNote="69" path="Samples/DH WARP3/DH WARP3_067_RR3.flac" />
      <sample rootNote="71" loNote="70" hiNote="72" path="Samples/DH WARP3/DH WARP3_071_RR3.flac" />
      <sample rootNote="74" loNote="73" hiNote="75" path="Samples/DH WARP3/DH WARP3_074_RR3.flac" />
      <sample rootNote="76" loNote="76" hiNote="77" path="Samples/DH WARP3/DH WARP3_076_RR3.flac" />
      <sample rootNote="78" loNote="78" hiNote="80" path="Samples/DH WARP3/DH WARP3_078_RR3.flac" />
      <sample rootNote="83" loNote="81" hiNote="89" path="Samples/DH WARP3/DH WARP3_083_RR3.flac" />
      <sample rootNote="96" loNote="90" hiNote="127" path="Samples/DH WARP3/DH WARP3_096_RR3.flac" />
    </group>
  </groups>

  <!-- ============================ EFFECTS ============================ -->
  <effects>
    <effect type="lowpass" frequency="15000" resonance="0.7" />                 <!-- position 0 -->
    <effect type="chorus" mix="0.18" modDepth="0.2" modRate="0.2" />            <!-- position 1 -->
    <effect type="delay" delayTimeFormat="musical_time" delayTime="4.0"
            stereoOffset="0.02" feedback="0.3" wetLevel="0.15" />               <!-- position 2 -->
    <effect type="convolution" irFile="IR/Hall.flac" mix="0.2" />               <!-- position 3 -->
    <effect type="gain" level="-3" />                                           <!-- position 4 -->
  </effects>

  <!-- ========================== MODULATION =========================== -->
  <modulators>
    <lfo shape="sine" frequency="5" modAmount="0.2" scope="voice">
      <binding type="general" level="group" position="0" parameter="GROUP_TUNING"
               modBehavior="add" translation="linear"
               translationOutputMin="0" translationOutputMax="0.5" />
      <binding type="general" level="group" position="1" parameter="GROUP_TUNING"
               modBehavior="add" translation="linear"
               translationOutputMin="0" translationOutputMax="0.5" />
      <binding type="general" level="group" position="2" parameter="GROUP_TUNING"
               modBehavior="add" translation="linear"
               translationOutputMin="0" translationOutputMax="0.5" />
    </lfo>
  </modulators>

  <!-- ========================= USER INTERFACE ======================== -->
  <ui width="812" height="375" bgColor="FFFFFFFF">
    <tab name="main">
      <label x="24" y="12" width="600" height="26" text="My First Instrument - Hard" textColor="FF000000" textSize="18" hAlign="left" />

      <!-- Amp -->
      <label x="24" y="50" width="250" height="18" text="Amp" textColor="FF666666" textSize="12" hAlign="left" />
      <control x="39" y="72" width="20" height="120" style="linear_bar_vertical"
               parameterName="Volume" showLabel="false" type="float" minValue="0" maxValue="1" value="0.8"
               trackForegroundColor="FF333333" trackBackgroundColor="FFDDDDDD">
        <binding type="amp" level="instrument" position="0" parameter="AMP_VOLUME" />
      </control>
      <label x="24" y="196" width="50" height="16" text="Volume" textColor="FF000000" textSize="11" hAlign="centred" />
      <control x="89" y="72" width="20" height="120" style="linear_bar_vertical"
               parameterName="Attack" showLabel="false" type="float" minValue="0" maxValue="5" value="0.02"
               trackForegroundColor="FF333333" trackBackgroundColor="FFDDDDDD">
        <binding type="amp" level="group" position="0" parameter="ENV_ATTACK" />
        <binding type="amp" level="group" position="1" parameter="ENV_ATTACK" />
        <binding type="amp" level="group" position="2" parameter="ENV_ATTACK" />
      </control>
      <label x="74" y="196" width="50" height="16" text="Attack" textColor="FF000000" textSize="11" hAlign="centred" />
      <control x="139" y="72" width="20" height="120" style="linear_bar_vertical"
               parameterName="Decay" showLabel="false" type="float" minValue="0" maxValue="5" value="0.3"
               trackForegroundColor="FF333333" trackBackgroundColor="FFDDDDDD">
        <binding type="amp" level="group" position="0" parameter="ENV_DECAY" />
        <binding type="amp" level="group" position="1" parameter="ENV_DECAY" />
        <binding type="amp" level="group" position="2" parameter="ENV_DECAY" />
      </control>
      <label x="124" y="196" width="50" height="16" text="Decay" textColor="FF000000" textSize="11" hAlign="centred" />
      <control x="189" y="72" width="20" height="120" style="linear_bar_vertical"
               parameterName="Sustain" showLabel="false" type="float" minValue="0" maxValue="1" value="0.8"
               trackForegroundColor="FF333333" trackBackgroundColor="FFDDDDDD">
        <binding type="amp" level="group" position="0" parameter="ENV_SUSTAIN" />
        <binding type="amp" level="group" position="1" parameter="ENV_SUSTAIN" />
        <binding type="amp" level="group" position="2" parameter="ENV_SUSTAIN" />
      </control>
      <label x="174" y="196" width="50" height="16" text="Sustain" textColor="FF000000" textSize="11" hAlign="centred" />
      <control x="239" y="72" width="20" height="120" style="linear_bar_vertical"
               parameterName="Release" showLabel="false" type="float" minValue="0" maxValue="10" value="0.8"
               trackForegroundColor="FF333333" trackBackgroundColor="FFDDDDDD">
        <binding type="amp" level="group" position="0" parameter="ENV_RELEASE" />
        <binding type="amp" level="group" position="1" parameter="ENV_RELEASE" />
        <binding type="amp" level="group" position="2" parameter="ENV_RELEASE" />
      </control>
      <label x="224" y="196" width="50" height="16" text="Release" textColor="FF000000" textSize="11" hAlign="centred" />

      <!-- Filter -->
      <label x="290" y="50" width="100" height="18" text="Filter" textColor="FF666666" textSize="12" hAlign="left" />
      <control x="305" y="72" width="20" height="120" style="linear_bar_vertical"
               parameterName="Cutoff" showLabel="false" type="float" minValue="200" maxValue="20000" value="15000"
               trackForegroundColor="FF333333" trackBackgroundColor="FFDDDDDD">
        <binding type="effect" level="instrument" position="0" parameter="FX_FILTER_FREQUENCY" />
      </control>
      <label x="290" y="196" width="50" height="16" text="Cutoff" textColor="FF000000" textSize="11" hAlign="centred" />
      <control x="355" y="72" width="20" height="120" style="linear_bar_vertical"
               parameterName="Res" showLabel="false" type="float" minValue="0.1" maxValue="4" value="0.7"
               trackForegroundColor="FF333333" trackBackgroundColor="FFDDDDDD">
        <binding type="effect" level="instrument" position="0" parameter="FX_FILTER_RESONANCE" />
      </control>
      <label x="340" y="196" width="50" height="16" text="Res" textColor="FF000000" textSize="11" hAlign="centred" />

      <!-- Chorus -->
      <label x="406" y="50" width="150" height="18" text="Chorus" textColor="FF666666" textSize="12" hAlign="left" />
      <control x="421" y="72" width="20" height="120" style="linear_bar_vertical"
               parameterName="Mix" showLabel="false" type="float" minValue="0" maxValue="1" value="0.18"
               trackForegroundColor="FF333333" trackBackgroundColor="FFDDDDDD">
        <binding type="effect" level="instrument" position="1" parameter="FX_MIX" />
      </control>
      <label x="406" y="196" width="50" height="16" text="Mix" textColor="FF000000" textSize="11" hAlign="centred" />
      <control x="471" y="72" width="20" height="120" style="linear_bar_vertical"
               parameterName="Rate" showLabel="false" type="float" minValue="0.01" maxValue="5" value="0.2"
               trackForegroundColor="FF333333" trackBackgroundColor="FFDDDDDD">
        <binding type="effect" level="instrument" position="1" parameter="FX_MOD_RATE" />
      </control>
      <label x="456" y="196" width="50" height="16" text="Rate" textColor="FF000000" textSize="11" hAlign="centred" />
      <control x="521" y="72" width="20" height="120" style="linear_bar_vertical"
               parameterName="Depth" showLabel="false" type="float" minValue="0" maxValue="1" value="0.2"
               trackForegroundColor="FF333333" trackBackgroundColor="FFDDDDDD">
        <binding type="effect" level="instrument" position="1" parameter="FX_MOD_DEPTH" />
      </control>
      <label x="506" y="196" width="50" height="16" text="Depth" textColor="FF000000" textSize="11" hAlign="centred" />

      <!-- Delay -->
      <label x="572" y="50" width="100" height="18" text="Delay" textColor="FF666666" textSize="12" hAlign="left" />
      <control x="587" y="72" width="20" height="120" style="linear_bar_vertical"
               parameterName="Mix" showLabel="false" type="float" minValue="0" maxValue="1" value="0.15"
               trackForegroundColor="FF333333" trackBackgroundColor="FFDDDDDD">
        <binding type="effect" level="instrument" position="2" parameter="FX_WET_LEVEL" />
      </control>
      <label x="572" y="196" width="50" height="16" text="Mix" textColor="FF000000" textSize="11" hAlign="centred" />
      <control x="637" y="72" width="20" height="120" style="linear_bar_vertical"
               parameterName="Feedback" showLabel="false" type="float" minValue="0" maxValue="0.9" value="0.3"
               trackForegroundColor="FF333333" trackBackgroundColor="FFDDDDDD">
        <binding type="effect" level="instrument" position="2" parameter="FX_FEEDBACK" />
      </control>
      <label x="622" y="196" width="50" height="16" text="Feedback" textColor="FF000000" textSize="11" hAlign="centred" />

      <!-- Reverb -->
      <label x="688" y="50" width="50" height="18" text="Reverb" textColor="FF666666" textSize="12" hAlign="left" />
      <control x="703" y="72" width="20" height="120" style="linear_bar_vertical"
               parameterName="Mix" showLabel="false" type="float" minValue="0" maxValue="1" value="0.2"
               trackForegroundColor="FF333333" trackBackgroundColor="FFDDDDDD">
        <binding type="effect" level="instrument" position="3" parameter="FX_MIX" />
      </control>
      <label x="688" y="196" width="50" height="16" text="Mix" textColor="FF000000" textSize="11" hAlign="centred" />

      <!-- LFO -->
      <label x="754" y="50" width="50" height="18" text="LFO" textColor="FF666666" textSize="12" hAlign="left" />
      <control x="769" y="72" width="20" height="120" style="linear_bar_vertical"
               parameterName="Vibrato" showLabel="false" type="float" minValue="0" maxValue="1" value="0.2"
               trackForegroundColor="FF333333" trackBackgroundColor="FFDDDDDD">
        <binding type="modulator" level="instrument" position="0" parameter="MOD_AMOUNT" />
      </control>
      <label x="754" y="196" width="50" height="16" text="Vibrato" textColor="FF000000" textSize="11" hAlign="centred" />
    </tab>
  </ui>
</DecentSampler>
