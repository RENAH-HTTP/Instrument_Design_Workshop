<?xml version="1.0" encoding="UTF-8"?>
<DecentSampler minVersion="1.27.0">
  <!-- HARD: round robin + legato + effects + LFO + full UI. See README.md -->

  <!-- ============================ SAMPLES ============================ -->
  <groups polyphony="1" glideTime="0.08" glideMode="legato" returnToHeldNote="true" seqMode="round_robin" seqLength="2" attack="0.02" decay="0.3" sustain="0.8" release="0.8" ampVelTrack="0.5">
    <group seqPosition="1">
      <sample rootNote="24" loNote="0" hiNote="30" path="Samples/DH WARP18/DH WARP18-C0-V127-O9LJ.flac" />
      <sample rootNote="36" loNote="31" hiNote="42" path="Samples/DH WARP18/DH WARP18-C1-V127-R79M.flac" />
      <sample rootNote="48" loNote="43" hiNote="54" path="Samples/DH WARP18/DH WARP18-C2-V127-D8ZV.flac" />
      <sample rootNote="60" loNote="55" hiNote="66" path="Samples/DH WARP18/DH WARP18-C3-V127-O9JD.flac" />
      <sample rootNote="72" loNote="67" hiNote="78" path="Samples/DH WARP18/DH WARP18-C4-V127-OY8E.flac" />
      <sample rootNote="84" loNote="79" hiNote="90" path="Samples/DH WARP18/DH WARP18-C5-V127-92KG.flac" />
      <sample rootNote="96" loNote="91" hiNote="127" path="Samples/DH WARP18/DH WARP18-C6-V127-ED8C.flac" />
    </group>
    <group seqPosition="2">
      <sample rootNote="24" loNote="0" hiNote="30" path="Samples/DH WARP18/DH WARP18-C0-V127-ZOOQ.flac" />
      <sample rootNote="36" loNote="31" hiNote="42" path="Samples/DH WARP18/DH WARP18-C1-V127-U4H7.flac" />
      <sample rootNote="48" loNote="43" hiNote="54" path="Samples/DH WARP18/DH WARP18-C2-V127-LJBG.flac" />
      <sample rootNote="60" loNote="55" hiNote="66" path="Samples/DH WARP18/DH WARP18-C3-V127-UXZK.flac" />
      <sample rootNote="72" loNote="67" hiNote="78" path="Samples/DH WARP18/DH WARP18-C4-V127-Q8G6.flac" />
      <sample rootNote="84" loNote="79" hiNote="90" path="Samples/DH WARP18/DH WARP18-C5-V127-AC6S.flac" />
      <sample rootNote="96" loNote="91" hiNote="127" path="Samples/DH WARP18/DH WARP18-C6-V127-X2WQ.flac" />
    </group>
  </groups>

  <!-- ============================ EFFECTS ============================ -->
  <effects>
    <effect type="lowpass" frequency="15000" resonance="0.7" />                 <!-- position 0 -->
    <effect type="chorus" mix="0.18" modDepth="0.2" modRate="0.2" />            <!-- position 1 -->
    <effect type="delay" delayTimeFormat="musical_time" delayTime="4.0"
            stereoOffset="0.02" feedback="0.3" wetLevel="0.15" />               <!-- position 2 -->
    <effect type="convolution" irFile="IR/Hall.flac" mix="0.2" />               <!-- position 3 -->
    <effect type="gain" level="-3" />                                           <!-- position 4 -->
  </effects>

  <!-- ========================== MODULATION =========================== -->
  <modulators>
    <lfo shape="sine" frequency="5" modAmount="0.2" scope="voice">
      <binding type="general" level="group" position="0" parameter="GROUP_TUNING"
               modBehavior="add" translation="linear"
               translationOutputMin="0" translationOutputMax="0.5" />
    </lfo>
  </modulators>

  <!-- ========================= USER INTERFACE ======================== -->
  <ui width="812" height="375" bgColor="FF14161F">
    <tab name="main">

      <!-- Header -->
      <rectangle x="0" y="0" width="812" height="56" fillColor="FF1E2230" />
      <rectangle x="0" y="54" width="812" height="2" fillColor="FF4FD1C5" />
      <label x="20" y="8" width="500" height="26" text="MY FIRST INSTRUMENT"
             textColor="FFFFFFFF" textSize="22" hAlign="left" />
      <label x="20" y="32" width="560" height="18"
             text="HARD  ·  7 zones  ·  2 round robins  ·  mono legato  ·  5-effect chain"
             textColor="FF8A93AD" textSize="12" hAlign="left" />
      <label x="600" y="18" width="192" height="20" text="LEVEL 3 / 3"
             textColor="FF4FD1C5" textSize="14" hAlign="right" />

      <!-- ========== Panel 1: AMP ENVELOPE ========== -->
      <rectangle x="16" y="68" width="480" height="142" fillColor="FF1E2230" />
      <label x="28" y="74" width="300" height="18" text="AMP ENVELOPE"
             textColor="FF4FD1C5" textSize="13" hAlign="left" />

      <labeled-knob x="26" y="96" width="80" height="106" label="Volume"
                    type="float" minValue="0" maxValue="1" value="0.8"
                    textColor="FFE8ECF5" textSize="13"
                    trackForegroundColor="FF4FD1C5" trackBackgroundColor="FF2E3446">
        <binding type="amp" level="instrument" position="0" parameter="AMP_VOLUME" />
      </labeled-knob>
      <labeled-knob x="116" y="96" width="80" height="106" label="Attack"
                    type="float" minValue="0" maxValue="5" value="0.02"
                    textColor="FFE8ECF5" textSize="13"
                    trackForegroundColor="FF4FD1C5" trackBackgroundColor="FF2E3446">
        <binding type="amp" level="group" position="0" parameter="ENV_ATTACK" />
      </labeled-knob>
      <labeled-knob x="206" y="96" width="80" height="106" label="Decay"
                    type="float" minValue="0" maxValue="5" value="0.3"
                    textColor="FFE8ECF5" textSize="13"
                    trackForegroundColor="FF4FD1C5" trackBackgroundColor="FF2E3446">
        <binding type="amp" level="group" position="0" parameter="ENV_DECAY" />
      </labeled-knob>
      <labeled-knob x="296" y="96" width="80" height="106" label="Sustain"
                    type="float" minValue="0" maxValue="1" value="0.8"
                    textColor="FFE8ECF5" textSize="13"
                    trackForegroundColor="FF4FD1C5" trackBackgroundColor="FF2E3446">
        <binding type="amp" level="group" position="0" parameter="ENV_SUSTAIN" />
      </labeled-knob>
      <labeled-knob x="386" y="96" width="80" height="106" label="Release"
                    type="float" minValue="0" maxValue="10" value="0.8"
                    textColor="FFE8ECF5" textSize="13"
                    trackForegroundColor="FF4FD1C5" trackBackgroundColor="FF2E3446">
        <binding type="amp" level="group" position="0" parameter="ENV_RELEASE" />
      </labeled-knob>

      <!-- ========== Panel 2: TONE (lowpass filter, effect position 0) ========== -->
      <rectangle x="508" y="68" width="288" height="142" fillColor="FF1E2230" />
      <label x="520" y="74" width="260" height="18" text="TONE  ·  LOW-PASS FILTER"
             textColor="FFF6AD55" textSize="13" hAlign="left" />

      <labeled-knob x="562" y="96" width="80" height="106" label="Cutoff"
                    type="float" minValue="200" maxValue="20000" value="15000"
                    textColor="FFE8ECF5" textSize="13"
                    trackForegroundColor="FFF6AD55" trackBackgroundColor="FF2E3446">
        <binding type="effect" level="instrument" position="0" parameter="FX_FILTER_FREQUENCY" />
      </labeled-knob>
      <labeled-knob x="662" y="96" width="80" height="106" label="Resonance"
                    type="float" minValue="0.1" maxValue="4" value="0.7"
                    textColor="FFE8ECF5" textSize="13"
                    trackForegroundColor="FFF6AD55" trackBackgroundColor="FF2E3446">
        <binding type="effect" level="instrument" position="0" parameter="FX_FILTER_RESONANCE" />
      </labeled-knob>

      <!-- ========== Panel 3: SPACE (chorus 1, delay 2, reverb 3) ========== -->
      <rectangle x="16" y="220" width="480" height="142" fillColor="FF1E2230" />
      <label x="28" y="226" width="300" height="18" text="SPACE  ·  CHORUS / DELAY / REVERB"
             textColor="FFB794F4" textSize="13" hAlign="left" />

      <labeled-knob x="26" y="248" width="80" height="106" label="Chorus"
                    type="float" minValue="0" maxValue="1" value="0.18"
                    textColor="FFE8ECF5" textSize="13"
                    trackForegroundColor="FFB794F4" trackBackgroundColor="FF2E3446">
        <binding type="effect" level="instrument" position="1" parameter="FX_MIX" />
      </labeled-knob>
      <labeled-knob x="116" y="248" width="80" height="106" label="Ch. Rate"
                    type="float" minValue="0.01" maxValue="5" value="0.2"
                    textColor="FFE8ECF5" textSize="13"
                    trackForegroundColor="FFB794F4" trackBackgroundColor="FF2E3446">
        <binding type="effect" level="instrument" position="1" parameter="FX_MOD_RATE" />
      </labeled-knob>
      <labeled-knob x="206" y="248" width="80" height="106" label="Delay"
                    type="float" minValue="0" maxValue="1" value="0.15"
                    textColor="FFE8ECF5" textSize="13"
                    trackForegroundColor="FFB794F4" trackBackgroundColor="FF2E3446">
        <binding type="effect" level="instrument" position="2" parameter="FX_WET_LEVEL" />
      </labeled-knob>
      <labeled-knob x="296" y="248" width="80" height="106" label="Feedback"
                    type="float" minValue="0" maxValue="0.9" value="0.3"
                    textColor="FFE8ECF5" textSize="13"
                    trackForegroundColor="FFB794F4" trackBackgroundColor="FF2E3446">
        <binding type="effect" level="instrument" position="2" parameter="FX_FEEDBACK" />
      </labeled-knob>
      <labeled-knob x="386" y="248" width="80" height="106" label="Reverb"
                    type="float" minValue="0" maxValue="1" value="0.2"
                    textColor="FFE8ECF5" textSize="13"
                    trackForegroundColor="FFB794F4" trackBackgroundColor="FF2E3446">
        <binding type="effect" level="instrument" position="3" parameter="FX_MIX" />
      </labeled-knob>

      <!-- ========== Panel 4: MOTION (LFO, modulator position 0) ========== -->
      <rectangle x="508" y="220" width="288" height="142" fillColor="FF1E2230" />
      <label x="520" y="226" width="260" height="18" text="MOTION  ·  LFO"
             textColor="FFF687B3" textSize="13" hAlign="left" />

      <labeled-knob x="518" y="248" width="80" height="106" label="Vibrato"
                    type="float" minValue="0" maxValue="1" value="0.2"
                    textColor="FFE8ECF5" textSize="13"
                    trackForegroundColor="FFF687B3" trackBackgroundColor="FF2E3446">
        <binding type="modulator" level="instrument" position="0" parameter="MOD_AMOUNT" />
      </labeled-knob>
      <label x="608" y="256" width="178" height="18" text="Sine LFO at 5 Hz"
             textColor="FFE8ECF5" textSize="12" hAlign="left" />
      <label x="608" y="276" width="178" height="18" text="wobbles the pitch."
             textColor="FF8A93AD" textSize="12" hAlign="left" />
      <label x="608" y="304" width="178" height="18" text="Play legato: notes glide"
             textColor="FF8A93AD" textSize="12" hAlign="left" />
      <label x="608" y="322" width="178" height="18" text="into each other (mono)."
             textColor="FF8A93AD" textSize="12" hAlign="left" />

    </tab>
  </ui>
</DecentSampler>
