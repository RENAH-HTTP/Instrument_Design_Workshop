<?xml version="1.0" encoding="UTF-8"?>
<DecentSampler minVersion="1.27.0">
  <groups>
    <group loVel="1" hiVel="127" attack="0.0" release="0.48">
      <sample rootNote="47" loNote="24" hiNote="127"
              path="..\Samples\BasitarPlucks\BasitarPlucks_047_RR1.flac" />
    </group>
  </groups>

  <ui>
    <tab name="main">
      <label x="24" y="20" width="500" height="30" text="UI Example" />
      <!-- These controls expose built-in sampler parameters. -->
      <control parameterName="AMP_VOLUME"
               x="24" y="72" width="100" height="100"
               minValue="-48" maxValue="12" value="0" />
      <control parameterName="ENV_ATTACK"
               x="144" y="72" width="100" height="100"
               minValue="0" maxValue="10" value="0" />
      <control parameterName="ENV_RELEASE"
               x="264" y="72" width="100" height="100"
               minValue="0" maxValue="10" value="0.48" />
    </tab>
  </ui>
</DecentSampler>
